# Nexus Repository - example configuration for a local/test environment.
# Copy this file to .env (ignored by git) and adjust the values:
#   cp .env.example .env

# Image tag of sonatype/nexus3 (variants: <version>, <version>-alpine, <version>-ubi)
NEXUS_VERSION=3.98.1

# Host port for the web interface and REST API (http://localhost:<port>)
NEXUS_PORT=8081

# JVM memory. Used as -Xms and -Xmx (keep them equal).
# Test: 2g on a host with 8 GB RAM. Production: e.g. 4g on a 16 GB host.
NEXUS_HEAP=2g

# JVM direct memory (-XX:MaxDirectMemorySize).
# Test: 2g. Production: e.g. 6g on a 16 GB host.
NEXUS_DIRECT_MEMORY=2g
