# Nexus Repository behind NGINX - example configuration for a local/test environment.
# Copy this file to .env (ignored by git) and adjust the values:
#   cp .env.example .env

# --- Nexus ---
# Image tag of sonatype/nexus3 (variants: <version>, <version>-alpine, <version>-ubi)
NEXUS_VERSION=3.98.1
# JVM memory. Test: 2g on a host with 8 GB RAM. Production: e.g. 4g / 6g on a 16 GB host.
NEXUS_HEAP=2g
NEXUS_DIRECT_MEMORY=2g

# --- NGINX ---
NGINX_IMAGE_VERSION=1.30.6-alpine
# Host ports published by NGINX
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- Host names ---
# Must resolve to the NGINX host (add them to /etc/hosts for local tests).
# They are also used in the generated self-signed certificate.
NEXUS_HOST=nexus.localhost
REGISTRY_HOST=registry.nexus.localhost

# --- Docker registry ---
# HTTP connector port configured in the Nexus Docker hosted repository (internal, not published)
REGISTRY_PORT=8082
