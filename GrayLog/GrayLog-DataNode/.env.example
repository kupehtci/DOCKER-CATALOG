# Copy this file to `.env` (same folder as docker-compose.yaml) and replace the placeholders.
#   cp .env.example .env
# The real `.env` is git-ignored: never commit it.

# ---------------------------------------------------------------------------
# GRAYLOG_PASSWORD_SECRET
# ---------------------------------------------------------------------------
# What it is: a random shared secret (NOT a password you log in with).
# What it is for:
#   - Graylog uses it to encrypt and salt sensitive values stored in MongoDB
#     (stored credentials, access tokens, user sessions...).
#   - The Data Node uses the same value to authenticate against the Graylog
#     server, so it MUST be identical in both services (the compose file
#     passes this single variable to both).
# What to put: a random string of at least 16 characters (64-96 recommended),
#   letters and digits only. Generate it with:
#     < /dev/urandom LC_ALL=C tr -dc 'A-Za-z0-9' | head -c96 ; echo
# Warning: do not change it once the stack has been started; data already
#   encrypted with the old value cannot be decrypted and the Data Node will
#   fail to connect. Changing it means wiping the volumes.
GRAYLOG_PASSWORD_SECRET=<random-string-of-96-characters>

# ---------------------------------------------------------------------------
# GRAYLOG_ROOT_PASSWORD_SHA2
# ---------------------------------------------------------------------------
# What it is: the SHA-256 hash (64 hex characters) of the password of the
#   built-in `admin` user. The plain password is never stored anywhere.
# What it is for: logging in to the web UI (http://127.0.0.1:9000) and the
#   REST API as `admin` once the preflight setup has finished.
# What to put: the hash of the password you choose, never the password itself.
#   Use `echo -n` so the trailing newline is not hashed:
#     Linux: echo -n 'YourAdminPassword' | sha256sum | cut -d' ' -f1
#     macOS: echo -n 'YourAdminPassword' | shasum -a 256 | cut -d' ' -f1
# This one can be changed at any time: update the value and recreate the
#   graylog container (docker compose up -d graylog).
GRAYLOG_ROOT_PASSWORD_SHA2=<sha256-hash-of-the-admin-password>
